{
  "name": "company-autocomplete",
  "version": "3.3.1",
  "description": "company-autocomplete",
  "scripts": {
    "clean:dist": "rimraf dist",
    "lint": "npx eslint \"src/**/*.{ts,js}\"",
    "dev": "concurrently \"npm run src:dev\" \"npm run docs:dev\"",
    "src:dev": "rolldown -c --watch",
    "build:types": "npm run clean:dist && tsc",
    "build": "npm run lint && npm run build:types && rolldown -c",
    "prepack": "npm run build",
    "pack:check": "npm run build && npm pack --dry-run --json --ignore-scripts",
    "changelog": "conventional-changelog -p angular -i CHANGELOG.md -s -r 0 -n changelog-option.js",
    "docs:dev": "vitepress dev docs",
    "docs:build": "vitepress build docs",
    "docs:serve": "vitepress serve docs",
    "lint-changelog": "concurrently \"npm run lint\" \"npm run changelog\""
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/zhensherlock/company-autocomplete.git"
  },
  "author": "zhensherlock",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/zhensherlock/company-autocomplete/issues"
  },
  "homepage": "https://zhensherlock.github.io/company-autocomplete/",
  "keywords": [
    "企业",
    "企业名称",
    "企业组件",
    "企业补全组件",
    "企业名称自动补全组件"
  ],
  "main": "index.cjs",
  "module": "dist/index.esm.js",
  "webpack": "dist/index.esm.js",
  "browser": "dist/index.esm.js",
  "unpkg": "dist/index.iife.min.js",
  "jsdelivr": "dist/index.iife.min.js",
  "types": "dist/types/main.d.ts",
  "exports": {
    ".": {
      "types": "./dist/types/main.d.ts",
      "import": {
        "node": "./index.mjs",
        "default": "./dist/index.esm.js"
      },
      "require": "./index.cjs"
    },
    "./package.json": "./package.json",
    "./dist/*": "./dist/*"
  },
  "files": [
    "dist",
    "index.js",
    "index.mjs",
    "index.cjs",
    "LICENSE",
    "README.md"
  ],
  "devDependencies": {
    "@commitlint/cli": "^19.8.1",
    "@commitlint/config-conventional": "^19.8.1",
    "@rollup/plugin-strip": "^3.0.4",
    "@typescript-eslint/eslint-plugin": "^8.60.0",
    "@typescript-eslint/parser": "^8.60.0",
    "autoprefixer": "^10.5.0",
    "concurrently": "^8.2.2",
    "conventional-changelog-angular": "^7.0.0",
    "conventional-changelog-cli": "^5.0.0",
    "cssnano": "^7.1.9",
    "element-plus": "^2.14.1",
    "eslint": "^9.39.4",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.6",
    "globals": "^16.5.0",
    "husky": "^9.1.7",
    "lint-staged": "^16.4.0",
    "prettier": "^3.8.3",
    "rimraf": "^6.1.3",
    "rolldown": "^1.0.3",
    "rollup-plugin-filesize": "^10.0.0",
    "rollup-plugin-postcss": "^4.0.2",
    "sass": "^1.100.0",
    "typescript": "^5.9.3",
    "vitepress": "^1.6.4"
  },
  "dependencies": {
    "@floating-ui/dom": "^1.7.6"
  }
}
